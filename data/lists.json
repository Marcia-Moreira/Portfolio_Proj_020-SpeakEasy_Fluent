                { "id": "market_7_f2", "target_text": "Is this gluten-free?", "native_text": "Isso é sem glúten?" },
                { "id": "market_7_f3", "target_text": "Where can I find...?", "native_text": "Onde encontro...?" },
                { "id": "market_7_f4", "target_text": "It's over there", "native_text": "Está ali" },
                { "id": "market_7_f5", "target_text": "Where's the dairy aisle?", "native_text": "Onde fica o corredor de laticínios?" },
                { "id": "market_7_f6", "target_text": "Can I get a rain check?", "native_text": "Posso levar depois com o mesmo preço?" },
