{
    "lists": [
        {
            "id": "about_me_1",
            "type": "list",
            "name": "About Me",
            "category": "daily_life",
            "phrases": [
                { "id": "about_me_1_f1", "target_text": "I'm from Brazil", "native_text": "Sou do Brasil" },
                { "id": "about_me_1_f2", "target_text": "I live in São Paulo", "native_text": "Moro em São Paulo" },
                { "id": "about_me_1_f3", "target_text": "I'm originally from Rio", "native_text": "Sou originalmente do Rio" },
                { "id": "about_me_1_f4", "target_text": "I'm a web developer", "native_text": "Sou desenvolvedora web" },
                { "id": "about_me_1_f5", "target_text": "I've been working with front-end", "native_text": "Trabalho com front-end" },
                { "id": "about_me_1_f6", "target_text": "I've been coming here for years", "native_text": "Venho aqui há anos" },
                { "id": "about_me_1_f7", "target_text": "It's my fourth time here", "native_text": "É minha quarta vez aqui" },
                { "id": "about_me_1_f8", "target_text": "I'm here for a tech conference", "native_text": "Estou aqui para uma conferência de tecnologia" },
                { "id": "about_me_1_f9", "target_text": "I grew up in the countryside", "native_text": "Cresci no interior" },
                { "id": "about_me_1_f10", "target_text": "I've been here for about three years", "native_text": "Estou aqui há uns três anos" },
                { "id": "about_me_1_f11", "target_text": "I'm still learning the language", "native_text": "Ainda estou aprendendo o idioma" },
                { "id": "about_me_1_f12", "target_text": "I work remotely", "native_text": "Trabalho remoto" }
            ]
        },
        {
            "id": "coffee_shop_2",
            "type": "list",
            "name": "Coffee Shop",
            "category": "food_and_drinks",
            "phrases": [
                { "id": "coffee_shop_2_f1", "target_text": "Can I get a black coffee?", "native_text": "Posso pedir um café preto?" },
                { "id": "coffee_shop_2_f2", "target_text": "No milk, no sugar", "native_text": "Sem leite, sem açúcar" },
                { "id": "coffee_shop_2_f3", "target_text": "Just black", "native_text": "Só puro" },
                { "id": "coffee_shop_2_f4", "target_text": "Anything else?", "native_text": "Mais alguma coisa?" },
                { "id": "coffee_shop_2_f5", "target_text": "That's it", "native_text": "É só isso" },
                { "id": "coffee_shop_2_f6", "target_text": "For here or to go?", "native_text": "Aqui ou para viagem?" },
                { "id": "coffee_shop_2_f7", "target_text": "To go, please", "native_text": "Para viagem, por favor" },
                { "id": "coffee_shop_2_f8", "target_text": "We'll call your name", "native_text": "Vamos chamar seu nome" },
                { "id": "coffee_shop_2_f9", "target_text": "Can I have a cup of tea?", "native_text": "Me vê um chá?" },
                { "id": "coffee_shop_2_f10", "target_text": "What's the Wi-Fi password?", "native_text": "Qual a senha do Wi-Fi?" },
                { "id": "coffee_shop_2_f11", "target_text": "Can I charge my phone here?", "native_text": "Posso carregar meu celular aqui?" },
                { "id": "coffee_shop_2_f12", "target_text": "Is the bathroom for customers only?", "native_text": "O banheiro é só pra cliente?" }
            ]
        },
        {
            "id": "on_the_street_3",
            "type": "list",
            "name": "On The Street",
            "category": "daily_life",
            "phrases": [
                { "id": "on_the_street_3_f1", "target_text": "Excuse me", "native_text": "Com licença" },
                { "id": "on_the_street_3_f2", "target_text": "Is this the way to...?", "native_text": "Esse é o caminho para...?" },
                { "id": "on_the_street_3_f3", "target_text": "How far is it?", "native_text": "É longe?" },
                { "id": "on_the_street_3_f4", "target_text": "Just around the corner", "native_text": "Logo ali na esquina" },
                { "id": "on_the_street_3_f5", "target_text": "Go straight", "native_text": "Siga reto" },
                { "id": "on_the_street_3_f6", "target_text": "Turn left/right", "native_text": "Vire esquerda/direita" },
                { "id": "on_the_street_3_f7", "target_text": "Is this seat taken?", "native_text": "Esse lugar está ocupado?" },
                { "id": "on_the_street_3_f8", "target_text": "Do you know what time it is?", "native_text": "Você tem horas?" },
                { "id": "on_the_street_3_f9", "target_text": "Can you help me out real quick?", "native_text": "Pode me ajudar rapidão?" },
                { "id": "on_the_street_3_f10", "target_text": "I think I'm lost", "native_text": "Acho que me perdi" }
            ]
        },
        {
            "id": "reactions_4",
            "type": "list",
            "name": "Reactions And Responses",
            "category": "conversation",
            "phrases": [
                { "id": "reactions_4_f1", "target_text": "Got it", "native_text": "Entendi" },
                { "id": "reactions_4_f2", "target_text": "Makes sense", "native_text": "Faz sentido" },
                { "id": "reactions_4_f3", "target_text": "No worries", "native_text": "Sem problema" },
                { "id": "reactions_4_f4", "target_text": "All good", "native_text": "Tudo certo" },
                { "id": "reactions_4_f5", "target_text": "My bad", "native_text": "Foi mal" },
                { "id": "reactions_4_f6", "target_text": "Fair enough", "native_text": "Justo" },
                { "id": "reactions_4_f7", "target_text": "Sounds good", "native_text": "Parece bom / combinado" },
                { "id": "reactions_4_f8", "target_text": "You're kidding, right?", "native_text": "Tá brincando, né?" },
                { "id": "reactions_4_f9", "target_text": "That's wild", "native_text": "Que loucura" },
                { "id": "reactions_4_f10", "target_text": "I feel you", "native_text": "Te entendo" },
                { "id": "reactions_4_f11", "target_text": "Same here", "native_text": "Por aqui também" },
                { "id": "reactions_4_f12", "target_text": "Tell me about it", "native_text": "Nem me fale" }
            ]
        },
        {
            "id": "career_networking_5",
            "type": "list",
            "name": "Career And Networking",
            "category": "work",
            "phrases": [
                { "id": "career_networking_5_f1", "target_text": "What do you do?", "native_text": "O que você faz?" },
                { "id": "career_networking_5_f2", "target_text": "I work in tech", "native_text": "Trabalho com tecnologia" },
                { "id": "career_networking_5_f3", "target_text": "I'm into web development", "native_text": "Trabalho com desenvolvimento web" },
                { "id": "career_networking_5_f4", "target_text": "What are you working on?", "native_text": "No que você está trabalhando?" },
                { "id": "career_networking_5_f5", "target_text": "That's interesting", "native_text": "Interessante" },
                { "id": "career_networking_5_f6", "target_text": "I'm between jobs right now", "native_text": "Tô desempregada no momento" },
                { "id": "career_networking_5_f7", "target_text": "I just got promoted", "native_text": "Acabei de ser promovida" },
                { "id": "career_networking_5_f8", "target_text": "I'm on a tight deadline", "native_text": "Tô com prazo apertado" },
                { "id": "career_networking_5_f9", "target_text": "Let's circle back on that", "native_text": "Depois a gente volta nisso" },
                { "id": "career_networking_5_f10", "target_text": "I'll shoot you an email", "native_text": "Te mando um e-mail" }
            ]
        },
        {
            "id": "airport_6",
            "type": "list",
            "name": "Airport / Airplane",
            "category": "travel",
            "phrases": [
                { "id": "airport_6_f1", "target_text": "I have a lactose-free meal", "native_text": "Tenho refeição sem lactose" },
                { "id": "airport_6_f2", "target_text": "I requested a special meal", "native_text": "Pedi uma refeição especial" },
                { "id": "airport_6_f3", "target_text": "Do you have anything without dairy?", "native_text": "Tem algo sem leite?" },
                { "id": "airport_6_f4", "target_text": "Window or aisle?", "native_text": "Janela ou corredor?" },
                { "id": "airport_6_f5", "target_text": "Carry-on or checked bag?", "native_text": "Bagagem de mão ou despachada?" },
                { "id": "airport_6_f6", "target_text": "I need to check this bag", "native_text": "Preciso despachar essa mala" },
                { "id": "airport_6_f7", "target_text": "Is my flight on time?", "native_text": "Meu voo está no horário?" },
                { "id": "airport_6_f8", "target_text": "Where's the boarding gate?", "native_text": "Onde é o portão de embarque?" },
                { "id": "airport_6_f9", "target_text": "I have a connecting flight", "native_text": "Tenho uma conexão" }
            ]
        },
        {
            "id": "market_7",
            "type": "list",
            "name": "Market",
            "category": "daily_life",
            "phrases": [
