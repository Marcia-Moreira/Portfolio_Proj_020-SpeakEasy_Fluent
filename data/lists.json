        {
            "id": "shopping_8",
            "type": "list",
            "name": "Shopping",
            "category": "daily_life",
            "phrases": [
                { "id": "shopping_8_f1", "target_text": "How much is this?", "native_text": "Quanto custa?" },
                { "id": "shopping_8_f2", "target_text": "Do you take card?", "native_text": "Aceitam cartão?" },
                { "id": "shopping_8_f3", "target_text": "Do you want a bag?", "native_text": "Quer sacola?" },
                { "id": "shopping_8_f4", "target_text": "You're all set", "native_text": "Tudo certo / finalizado" },
                { "id": "shopping_8_f5", "target_text": "I'm just browsing, thanks", "native_text": "Só tô olhando, valeu" },
                { "id": "shopping_8_f6", "target_text": "Can I get a gift receipt?", "native_text": "Dá pra tirar notinha de presente?" },
                { "id": "shopping_8_f7", "target_text": "This is a bit pricey", "native_text": "Isso tá meio caro" }
            ]
        },
        {
            "id": "event_9",
            "type": "list",
            "name": "Tech Event",
            "category": "events",
            "phrases": [
                { "id": "event_9_f1", "target_text": "Can I grab one?", "native_text": "Posso pegar um?" },
                { "id": "event_9_f2", "target_text": "Is this free?", "native_text": "Isso é de graça?" },
                { "id": "event_9_f3", "target_text": "Can I scan my badge?", "native_text": "Posso escanear meu crachá?" },
                { "id": "event_9_f4", "target_text": "What do I need to do?", "native_text": "O que preciso fazer?" },
                { "id": "event_9_f5", "target_text": "How does it work?", "native_text": "Como funciona?" },
                { "id": "event_9_f6", "target_text": "We're doing a giveaway", "native_text": "Estamos fazendo um sorteio" },
                { "id": "event_9_f7", "target_text": "What's the schedule for today?", "native_text": "Qual é a programação de hoje?" },
                { "id": "event_9_f8", "target_text": "Do you have a map of the venue?", "native_text": "Tem um mapa do local?" },
                { "id": "event_9_f9", "target_text": "Where's the registration desk?", "native_text": "Onde fica o credenciamento?" }
            ]
        },
        {
            "id": "lactose_10",
            "type": "list",
            "name": "Lactose / Restrictions",
            "category": "food",
            "phrases": [
