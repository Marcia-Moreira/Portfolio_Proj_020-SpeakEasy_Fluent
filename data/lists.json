                { "id": "lactose_10_f2", "target_text": "No dairy, please", "native_text": "Sem leite, por favor" },
                { "id": "lactose_10_f3", "target_text": "Does this have milk?", "native_text": "Isso tem leite?" },
                { "id": "lactose_10_f4", "target_text": "I'll have the vegan option", "native_text": "Vou querer a opção vegana" },
                { "id": "lactose_10_f5", "target_text": "Is this made with butter?", "native_text": "Isso é feito com manteiga?" },
                { "id": "lactose_10_f6", "target_text": "I can't do dairy at all", "native_text": "Não posso comer leite de jeito nenhum" }
            ]
        },
        {
            "id": "chunks_11",
            "type": "list",
            "name": "Chunks",
            "category": "spoken_english",
            "phrases": [
