                { "id": "chunks_11_f2", "target_text": "Let me check", "native_text": "Deixa eu ver" },
                { "id": "chunks_11_f3", "target_text": "Give me a second", "native_text": "Um segundo" },
                { "id": "chunks_11_f4", "target_text": "Hang on", "native_text": "Espera aí" },
                { "id": "chunks_11_f5", "target_text": "I'm good", "native_text": "Estou bem / não preciso" },
                { "id": "chunks_11_f6", "target_text": "I'm all set", "native_text": "Já estou resolvida" },
                { "id": "chunks_11_f7", "target_text": "Long time no see", "native_text": "Quanto tempo" },
                { "id": "chunks_11_f8", "target_text": "Take your time", "native_text": "Fica à vontade / sem pressa" },
                { "id": "chunks_11_f9", "target_text": "I'll be right back", "native_text": "Já volto" },
                { "id": "chunks_11_f10", "target_text": "Don't worry about it", "native_text": "Esquece / fica tranquilo" }
            ]
        },
        {
            "id": "reductions_12",
            "type": "list",
            "name": "Reductions",
            "category": "spoken_english",
            "phrases": [
                { "id": "reductions_12_f1", "target_text": "Gonna = going to", "native_text": "I'm gonna go → Vou ir" },
                { "id": "reductions_12_f2", "target_text": "Wanna = want to", "native_text": "I wanna try → Quero tentar" },
                { "id": "reductions_12_f3", "target_text": "Gotta = got to", "native_text": "I gotta go → Tenho que ir" },
                { "id": "reductions_12_f4", "target_text": "Lemme = let me", "native_text": "Lemme see → Deixa eu ver" },
                { "id": "reductions_12_f5", "target_text": "Kinda = kind of", "native_text": "It's kinda far → É meio longe" },
                { "id": "reductions_12_f6", "target_text": "Outta = out of", "native_text": "I'm outta here → Vou vazar" },
                { "id": "reductions_12_f7", "target_text": "C'mon = come on", "native_text": "C'mon man! → Qual é, cara!" }
            ]
        },
        {
            "id": "corporate_13",
            "type": "list",
            "name": "Corporate / Tech Terms",
            "category": "work",
            "phrases": [
                { "id": "corporate_13_f1", "target_text": "Deadline", "native_text": "Prazo" },
                { "id": "corporate_13_f2", "target_text": "Follow up", "native_text": "Acompanhar" },
                { "id": "corporate_13_f3", "target_text": "Touch base", "native_text": "Alinhar rapidamente" },
                { "id": "corporate_13_f4", "target_text": "Let's sync", "native_text": "Vamos alinhar" },
                { "id": "corporate_13_f5", "target_text": "Circle back", "native_text": "Voltar ao assunto" },
                { "id": "corporate_13_f6", "target_text": "I'm looping you in", "native_text": "Vou te incluir no loop" },
                { "id": "corporate_13_f7", "target_text": "Let's table that for now", "native_text": "Vamos deixar isso de lado por enquanto" },
                { "id": "corporate_13_f8", "target_text": "What's the game plan?", "native_text": "Qual o plano?" },
                { "id": "corporate_13_f9", "target_text": "I'll take the lead on this", "native_text": "Vou ficar responsável por isso" }
            ]
        },
        {
